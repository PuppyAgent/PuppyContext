{
  "name": "puppyone",
  "version": "0.2.1",
  "description": "PuppyOne CLI — cloud file system for AI Agents",
  "type": "module",
  "bin": {
    "puppyone": "bin/puppyone.js"
  },
  "scripts": {
    "test": "bash tests/run.sh",
