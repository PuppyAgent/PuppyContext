  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppyone-ai/puppyone-cloud.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/puppyone-ai/puppyone-cloud#readme",
  "bugs": {
    "url": "https://github.com/puppyone-ai/puppyone-cloud/issues"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "commander": "^13.1.0"
  }
}
