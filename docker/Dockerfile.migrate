FROM python:3.12.11-slim-bookworm
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl postgresql-client && rm -rf /var/lib/apt/lists/*
# Same CLI as database CI; checksums come from the upstream v2.107.0 release.
RUN case "$TARGETARCH" in \
      amd64) checksum=ea233b337be698cee5bbca0795ee3e63b9dd154948c515c03cb72f191b3d103c ;; \
      arm64) checksum=d54648dd7f46ab824ba483bf4db712235a58c3242c2ff675ac7732a9b4f21e0f ;; \
      *) exit 1 ;; esac \
    && curl -fsSL "https://github.com/supabase/cli/releases/download/v2.107.0/supabase_2.107.0_linux_${TARGETARCH}.tar.gz" -o /tmp/cli.tar.gz \
    && echo "$checksum  /tmp/cli.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/cli.tar.gz -C /usr/local/bin supabase supabase-go \
    && rm /tmp/cli.tar.gz \
    && supabase --version
WORKDIR /app
COPY backend/uv.lock /tmp/migration-uv.lock
COPY scripts/migration_dependencies.py /tmp/migration_dependencies.py
RUN python /tmp/migration_dependencies.py /tmp/migration-uv.lock > /tmp/migration-requirements.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/migration-requirements.txt
COPY backend/src/infra/data_migrations /app/backend/src/infra/data_migrations
COPY backend/pyproject.toml /app/backend/pyproject.toml
COPY supabase /app/supabase
COPY scripts/database_history.py scripts/self_hosted_migrate.py /app/scripts/
CMD ["python", "scripts/self_hosted_migrate.py"]
