# ============================================================
# PuppyOne Backend — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_MODULE="src.main"
APP_ENV="development"
DEBUG="false"
PORT="9090"
PUBLIC_URL="http://localhost:9090"
FRONTEND_URL="http://localhost:3000"

# SERVICE_ROLE controls which service starts (api | upload_worker | import_worker | synchronize_worker | mcp_server)
# Leave unset to start the default API service.
# SERVICE_ROLE=api

# ── Version Engine Trace ────────────────────────────────────
# Empty/omitted: enabled automatically in DEBUG=true; slow summaries only in production.
# Set true locally when chasing Save latency; keep false in production unless debugging.
# VERSION_TRACE_ENABLED="true"
VERSION_TRACE_SLOW_PHASE_MS="250"
VERSION_TRACE_SLOW_REQUEST_MS="2000"

# ── Internal ─────────────────────────────────────────────────
# Random secret shared between internal services
INTERNAL_API_SECRET="change-me-random-secret"
# Stable HMAC secret for hashing Access surface credentials. Rotating it
# invalidates existing MCP/Access keys unless credentials are reissued.
ACCESS_CREDENTIAL_HASH_SECRET="change-me-random-access-credential-secret"
# Optional previous key, verification only; retain until all old credentials rotate.
ACCESS_CREDENTIAL_PREVIOUS_HASH_SECRET=""

# ── Entitlements / Billing ───────────────────────────────────
# Open-source/self-hosted default: do not enforce hosted SaaS billing gates.
# Hosted PuppyOne should set:
#   ENTITLEMENTS_MODE="db"
#   BILLING_ENFORCEMENT="required"
ENTITLEMENTS_MODE="disabled"
BILLING_ENFORCEMENT="disabled"
LOCAL_ENTITLEMENTS_FILE=""
# 官方 Hosted 环境按顺序先设为 shadow，验收后再切 required。
BILLING_UI_ENABLED="false"
BILLING_WRITES_ENABLED="false"
SEAT_BILLING_MODE="disabled"
RUNTIME_METERING_MODE="disabled"
STORAGE_ENFORCEMENT_MODE="disabled"
PUPPYPAY_BASE_URL=""
PUPPYPAY_INTERNAL_API_SECRET=""
PUPPYPAY_TIMEOUT_SECONDS="10"
ENTITLEMENT_PROVISIONING_INTERVAL_SECONDS="30"
ENTITLEMENT_PROVISIONING_BATCH_SIZE="25"
ENTITLEMENT_PROVISIONING_LEASE_SECONDS="60"
SEAT_PROPOSAL_INTERVAL_SECONDS="30"
SEAT_PROPOSAL_BATCH_SIZE="25"
SEAT_PROPOSAL_LEASE_SECONDS="60"
RUNTIME_DEFAULT_RESERVATION_UNITS="10"
RUNTIME_AGENT_MAX_UNITS="30"
RUNTIME_AGENT_TIMEOUT_SECONDS="1800"
RUNTIME_RESERVATION_CLAIM_SECONDS="120"
RUNTIME_BILLING_HEARTBEAT_SECONDS="300"
RUNTIME_BILLING_RECOVERY_INTERVAL_SECONDS="60"
RUNTIME_BILLING_RECOVERY_RETRY_SECONDS="180"
STORAGE_RECONCILIATION_INTERVAL_SECONDS="3600"
STORAGE_RECONCILIATION_MIN_AGE_SECONDS="86400"
STORAGE_RECONCILIATION_BATCH_SIZE="25"

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="<supabase-service-role-key>"
SUPABASE_ANON_KEY="<supabase-anon-key>"

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET="<random-base64-secret-min-64-chars>"
MCP_TOKEN_SECRET="<different-random-base64-secret-min-64-chars>"
MCP_TOKEN_AUDIENCE="puppyone-mcp"
MCP_TOKEN_TTL_SECONDS="2592000"
# Shared, fail-closed store for login/check-email rate limits and one-time
# Desktop OAuth state. Every API replica must point to the same Redis.
AUTH_SECURITY_REDIS_URL="redis://localhost:6379/0"
# Browser-reachable origins; SUPABASE_URL may instead be internal service DNS.
SUPABASE_PUBLIC_URL="https://<project-ref>.supabase.co"
# Include the API prefix because the backend callback route is
# /api/v1/auth/desktop/callback. Random 127.0.0.1/::1 loopback callbacks are
# accepted only when the Desktop supplies a valid S256 PKCE challenge.
DESKTOP_AUTH_PUBLIC_BASE_URL="http://localhost:9090/api/v1"
DESKTOP_AUTH_ALLOWED_CALLBACKS="puppyone://auth/callback"

# Set to "true" to bypass authentication in local development
SKIP_AUTH="false"

# ── S3 / Storage ─────────────────────────────────────────────
USE_REAL_S3="false"
S3_ENDPOINT_URL="http://localhost:4566"   # LocalStack default; replace with real endpoint for production
S3_BUCKET_NAME="contextbase"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="<your-s3-access-key-id>"
S3_SECRET_ACCESS_KEY="<your-s3-secret-access-key>"

# PuppyOne-managed Office editing. These settings belong only to the hosted
# backend. Desktop users never configure a Document Server, JWT, callback
# listener, or Docker runtime. Keep the two secrets distinct.
PUPPYONE_OFFICE_ENABLED="false"
PUPPYONE_OFFICE_DOCUMENT_SERVER_URL="https://office.puppyone.ai"
PUPPYONE_OFFICE_PUBLIC_BASE_URL="https://api.puppyone.ai"
PUPPYONE_OFFICE_JWT_SECRET="<at-least-32-random-characters>"
PUPPYONE_OFFICE_CAPABILITY_SECRET="<different-at-least-32-random-characters>"
PUPPYONE_OFFICE_REDIS_URL="redis://localhost:6379/0"
# Comma-separated exact origins from which ONLYOFFICE may return edited bytes.
PUPPYONE_OFFICE_DOWNLOAD_ORIGINS="https://office.puppyone.ai"

# ── Replica-local derived caches ─────────────────────────────
# Hosted replicas must keep these reconstructable caches ephemeral. Persistent
# host storage is rejected until a shared/distributed cleanup adapter exists.
HOST_DERIVED_STORAGE_MODE="ephemeral"
WORKSPACE_BASE_DIR="/tmp/contextbase"
GIT_VIEW_CACHE_DIR="~/.puppyone/git-view-cache"

# ── Template Registry ───────────────────────────────────────
# "builtin" serves the starter templates shipped with this open-source build.
# "disabled" hides the catalog. "remote" talks to a separately operated,
# read-only Registry over HTTPS; it does not reuse this app's Supabase/S3.
TEMPLATE_REGISTRY_MODE="builtin"
TEMPLATE_REGISTRY_URL=""
TEMPLATE_REGISTRY_TIMEOUT_SECONDS="10"
TEMPLATE_REGISTRY_CACHE_TTL_SECONDS="60"
# Hosted remote registries should require signed immutable releases. Values
# are {"key-id":"base64url-encoded-raw-32-byte-Ed25519-public-key"}.
TEMPLATE_REGISTRY_REQUIRE_SIGNATURE="true"
TEMPLATE_REGISTRY_TRUSTED_KEYS_JSON="{}"
TEMPLATE_REGISTRY_MAX_METADATA_BYTES="5242880"
TEMPLATE_BUNDLE_MAX_COMPRESSED_BYTES="52428800"
TEMPLATE_BUNDLE_MAX_EXPANDED_BYTES="262144000"
TEMPLATE_BUNDLE_MAX_FILE_BYTES="52428800"
TEMPLATE_BUNDLE_MAX_FILES="2000"
TEMPLATE_BUNDLE_MAX_PATH_LENGTH="255"
TEMPLATE_BUNDLE_MAX_PATH_DEPTH="32"

# ── LLM ─────────────────────────────────────────────────────
# Primary LLM provider (used via LiteLLM)
ANTHROPIC_API_KEY="<your-anthropic-api-key>"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_MODEL="claude-opus-4-5-20251101"

# Optional alternative providers
OPENROUTER_API_KEY=""
DEEPINFRA_API_KEY=""

# ── OCR / ETL ────────────────────────────────────────────────
# OCR provider: "mineru" | "reducto" | "deepseek"
OCR_PROVIDER="deepseek"
ENABLE_ETL="true"

# MineRU (optional, for PDF extraction)
MINERU_API_KEY=""

# ── Redis (ARQ task queue) ───────────────────────────────────
ETL_REDIS_URL="redis://localhost:6379"
ETL_ARQ_QUEUE_NAME="etl"
IMPORT_ARQ_QUEUE_NAME="imports"
# Cutover requires stopped old producers and drained imports/syncs queues.
SYNCHRONIZE_ARQ_QUEUE_NAME="synchronize"
SYNCHRONIZE_TASK_TIMEOUT="900"

# ── MCP Server ──────────────────────────────────────────────
# API service only: internal/public URL of the central MCP service.
# Local MCP service default port is 3090 when SERVICE_ROLE=mcp_server.
MCP_SERVER_URL="http://localhost:3090"
# MCP service only: URL of the main API service for internal runtime lookups.
MAIN_SERVICE_URL="http://localhost:9090"

# ── Sandbox ──────────────────────────────────────────────────
# Sandbox backend: "auto" | "docker" | "e2b"
# - auto: local development only; use E2B when configured, otherwise Docker
# - docker: use the local Docker daemon
# - e2b: required in staging/production; missing credentials fail closed
SANDBOX_TYPE="auto"
# Dedicated sandbox temp directory. Only needed when the backend runs inside
# a container but launches sandbox containers via the host Docker daemon.
SANDBOX_TMPDIR=""
E2B_API_KEY=""

# ── OAuth — GitHub ───────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/oauth/github/callback"

# ── OAuth — Notion ───────────────────────────────────────────
NOTION_API_KEY=""

# ── OAuth — Google (shared across all Google services) ───────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:3000/oauth/google-sheets/callback"
GMAIL_REDIRECT_URI="http://localhost:3000/oauth/gmail/callback"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/oauth/google-drive/callback"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/oauth/google-calendar/callback"
GOOGLE_DOCS_REDIRECT_URI="http://localhost:3000/oauth/google-docs/callback"
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="http://localhost:3000/oauth/google-search-console/callback"
